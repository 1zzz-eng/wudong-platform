.pg{padding:0 24rpx 40rpx}.search{display:flex;gap:16rpx;padding:20rpx 0}.si{flex:1;height:74rpx;background:var(--w);border-radius:37rpx;padding:0 28rpx;font-size:26rpx;box-shadow:var(--s)}.sb{width:120rpx;height:74rpx;background:var(--p);color:#fff;border-radius:37rpx;font-size:26rpx;display:flex;align-items:center;justify-content:center;font-weight:bold}
.cats{white-space:nowrap;padding:0 0 20rpx;display:flex;gap:16rpx}.ct{display:inline-block;padding:12rpx 32rpx;background:var(--w);border-radius:32rpx;font-size:26rpx;color:var(--t2);box-shadow:var(--s)}.on{background:var(--p);color:#fff}
.ld,.emp{text-align:center;padding:80rpx 0;color:var(--t3)}
.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.card{width:calc(50% - 10rpx);background:var(--w);border-radius:var(--r);overflow:hidden;box-shadow:var(--s);margin-bottom:20rpx}.ci{width:100%;height:340rpx;display:block}.cb{padding:16rpx 18rpx}.cn{font-size:26rpx;color:var(--t);line-height:1.4;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.cr{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.cp{font-size:32rpx;color:var(--a);font-weight:bold}.cs{font-size:20rpx;color:var(--t3)}