<view class="pg">
  <view class="tabs"><text class="tb {{tab=='r'?'on':''}}" bindtap="onT" data-t="r">餐厅美食</text><text class="tb {{tab=='f'?'on':''}}" bindtap="onT" data-t="f">农产品特产</text></view>
  <view wx:if="{{list.length===0}}" class="emp">暂无内容</view>
  <view class="card" wx:for="{{list}}" wx:key="id" style="margin-bottom:20rpx">
    <image class="ci" src="{{item.image}}" mode="aspectFill"/>
    <view class="cb"><text class="cn">{{item.name}}</text><text class="cd">{{item.desc}}</text>
      <view class="tags" wx:if="{{item.tags}}"><text class="tg" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view>
      <view class="cf" wx:if="{{item.price}}"><text class="cp">¥{{item.price}}</text><text class="cu" wx:if="{{item.unit}}">/{{item.unit}}</text></view>
    </view>
  </view>
</view>