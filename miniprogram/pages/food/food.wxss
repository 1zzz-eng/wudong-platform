.pg{padding:0 24rpx 40rpx}.tabs{display:flex;background:var(--w);border-radius:var(--r);overflow:hidden;margin:20rpx 0;box-shadow:var(--s)}.tb{flex:1;text-align:center;padding:22rpx 0;font-size:28rpx;color:var(--t2);border-bottom:4rpx solid transparent}.on{color:var(--p);font-weight:bold;border-bottom-color:var(--p)}.emp{text-align:center;padding:80rpx;color:var(--t3)}
.card{background:var(--w);border-radius:var(--r);overflow:hidden;box-shadow:var(--s)}.ci{width:100%;height:320rpx;display:block}.cb{padding:20rpx}.cn{font-size:30rpx;font-weight:bold;color:var(--t);display:block}.cd{font-size:24rpx;color:var(--t3);display:block;margin:8rpx 0}.tags{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:8rpx}.tg{background:#FFF1EA;color:var(--a);font-size:20rpx;padding:4rpx 16rpx;border-radius:20rpx}.cf{display:flex;align-items:baseline;margin-top:16rpx}.cp{font-size:34rpx;color:var(--a);font-weight:bold}.cu{font-size:22rpx;color:var(--t3);margin-left:4rpx}