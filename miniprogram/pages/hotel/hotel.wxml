<view class="pg">
  <view class="st">苗寨民宿</view>
  <view class="card" wx:for="{{list}}" wx:key="id" style="margin-bottom:20rpx">
    <image class="ci" src="{{item.image}}" mode="aspectFill"/>
    <view class="cb"><text class="cn">{{item.name}}</text><text class="cd">{{item.desc}}</text>
      <view class="tags"><text class="tg" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view>
      <view class="cf"><text class="cp">¥{{item.price}}</text><text class="cu">/晚</text><view class="btn">预订</view></view>
    </view>
  </view>
</view>