.pg{padding:0 24rpx 40rpx}.top{padding:32rpx 0 12rpx;display:flex;justify-content:space-between;align-items:baseline}.logo{font-size:42rpx;font-weight:bold;color:var(--p);letter-spacing:4rpx}.sub{font-size:22rpx;color:var(--t3)}
.search{display:flex;gap:16rpx;padding:0 0 20rpx}.si{flex:1;height:74rpx;background:var(--w);border-radius:37rpx;padding:0 28rpx;font-size:26rpx;box-shadow:var(--s)}.sb{width:120rpx;height:74rpx;background:var(--p);color:#fff;border-radius:37rpx;font-size:26rpx;display:flex;align-items:center;justify-content:center;font-weight:bold}
.sw{width:100%;height:340rpx;border-radius:var(--r);overflow:hidden;margin-bottom:24rpx}.swi{width:100%;height:100%}.swt{position:absolute;bottom:0;left:0;right:0;padding:50rpx 24rpx 20rpx;background:linear-gradient(transparent,rgba(0,0,0,0.5));color:#fff;font-size:32rpx;font-weight:bold}
.icons{display:flex;justify-content:space-around;background:var(--w);border-radius:var(--r);padding:28rpx 12rpx;margin-bottom:24rpx;box-shadow:var(--s)}.ic{display:flex;flex-direction:column;align-items:center}.icb{width:90rpx;height:90rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:10rpx}.icc{font-size:40rpx}.ict{font-size:22rpx;color:var(--t2)}
.sec{margin:10rpx 0 20rpx}.st{font-size:34rpx;font-weight:bold;color:var(--t);padding-left:8rpx;border-left:6rpx solid var(--p)}
.ld{text-align:center;padding:80rpx 0;color:var(--t3)}
.grid{display:flex;flex-wrap:wrap;justify-content:space-between}.card{width:calc(50% - 10rpx);background:var(--w);border-radius:var(--r);overflow:hidden;box-shadow:var(--s);margin-bottom:20rpx}.ci{width:100%;height:340rpx;display:block}.cb{padding:16rpx 18rpx}.cn{font-size:26rpx;color:var(--t);line-height:1.4;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.cr{display:flex;justify-content:space-between;align-items:center;margin-top:12rpx}.cp{font-size:32rpx;color:var(--a);font-weight:bold}.cs{font-size:20rpx;color:var(--t3)}