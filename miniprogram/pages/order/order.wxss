.pg{padding:0 24rpx 40rpx}.tabs{display:flex;background:var(--w);border-radius:var(--r);overflow:hidden;margin:20rpx 0;box-shadow:var(--s)}.tb{flex:1;text-align:center;padding:20rpx 0;font-size:26rpx;color:var(--t2);border-bottom:4rpx solid transparent}.on{color:var(--p);font-weight:bold;border-bottom-color:var(--p)}.emp{text-align:center;padding:80rpx;color:var(--t3)}
.oc{background:var(--w);border-radius:var(--r);padding:20rpx;margin-bottom:16rpx;box-shadow:var(--s)}.ot{display:flex;justify-content:space-between;font-size:24rpx;color:var(--t3);margin-bottom:16rpx}.os{color:var(--a)}.og{display:flex;gap:16rpx}.oi{width:100rpx;height:100rpx;border-radius:12rpx;flex-shrink:0}.oin{flex:1}.onm{font-size:28rpx;display:block}.opr{font-size:28rpx;color:var(--a);font-weight:bold;margin-top:6rpx;display:block}