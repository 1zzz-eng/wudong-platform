.pg{padding:24rpx;min-height:100vh}.hd{background:linear-gradient(135deg,#1F5FA8,#3A7EC8);border-radius:var(--r);padding:40rpx 32rpx;display:flex;align-items:center;margin-bottom:24rpx}.av2{width:120rpx;height:120rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,0.5)}.ui{margin-left:24rpx;flex:1}.nn{font-size:36rpx;color:#fff;font-weight:bold;display:block}.ph2{font-size:24rpx;color:rgba(255,255,255,0.8);margin-top:6rpx;display:block}
.card2{background:var(--w);border-radius:var(--r);padding:24rpx;margin-bottom:20rpx;box-shadow:var(--s)}.ct2{font-size:30rpx;font-weight:bold;color:var(--t);margin-bottom:24rpx;display:block}.or2{display:flex;justify-content:space-around}.oi2{display:flex;flex-direction:column;align-items:center}.oic{font-size:44rpx;margin-bottom:8rpx}.oit{font-size:24rpx;color:var(--t2)}
.mr{display:flex;justify-content:space-between;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #f0f0f0;font-size:28rpx}.ar{color:#ccc}
.lo{text-align:center;background:var(--w);border-radius:var(--r);padding:24rpx;color:#FF4D4F;font-size:28rpx;box-shadow:var(--s);margin-top:40rpx}